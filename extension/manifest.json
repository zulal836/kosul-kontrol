{
  "manifest_version": 3,
  "name": "Koşul Kontrol",
  "version": "1.0.0",
  "description": "Kanıta dayalı sözleşme okuma yardımcısı. Hukuki tavsiye değildir.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "action": {
    "default_title": "Bu sayfanın koşullarını incele"
  },
  "background": {
    "service_worker": "background.js"
  }
}
